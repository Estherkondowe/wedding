# ── Database (Neon PostgreSQL) ─────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Server ─────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ───────────────────────────────────
# Exact origin of the frontend (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000

# ── Admin ──────────────────────────────────
# Shared secret for GET /api/rsvp (viewing submissions).
# Generate one: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_KEY=change-me-to-a-long-random-string
